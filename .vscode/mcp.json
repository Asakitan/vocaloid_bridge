{
  "servers": {
    "vocaloid6-native": {
      "type": "stdio",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["-m", "vocaloid_bridge"],
      "env": {
        "VOCALOID_WORKSPACE": "${workspaceFolder}",
        "PYTHONPATH": "${workspaceFolder}",
        "PYTHONUTF8": "1"
      }
    }
  }
}