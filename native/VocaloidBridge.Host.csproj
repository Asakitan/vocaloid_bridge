<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <VocaloidInstall Condition="'$(VocaloidInstall)' == ''">C:\Program Files\VOCALOID6\Editor</VocaloidInstall>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="VOCALOID6">
      <HintPath>$(VocaloidInstall)\VOCALOID6.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>